<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NarativeNodeGraph.Views"
             xmlns:vm="clr-namespace:NarativeNodeGraph.ViewModels"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="av"
             x:Class="NarativeNodeGraph.Views.GraphView"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:NarativeNodeGraph.Behaviors"
             x:Name="graphRoot"
             av:DesignHeight="2.766"
             av:DesignWidth="6.156">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="#1e1e1e">
        <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Panel.ZIndex="1000">
            <Button Content="Save"
                Command="{Binding SaveCommand}"
                Margin="0,0,8,0"/>

            <Button Content="Load"
                Command="{Binding LoadCommand}"
                Margin="0,0,8,0"/>
            
            <Button Content="Validate"
                    Command="{Binding ValidateCommand}"
                    Margin="0,0,8,0"/>
            
            <Button Content="Play"
                    Command="{Binding PlayCommand}"
                    Margin="0,0,8,0"/>
        </StackPanel>
        <Canvas Background="Transparent"
                        Width="100000"
                        Height="100000">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                    <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}"/>
                </TransformGroup>
            </Canvas.RenderTransform>
            <Canvas.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Add Start Node"
                  Command="{Binding AddNodeCommand}"
                  CommandParameter="{x:Static vm:NodeKind.Start}" />

                <MenuItem Header="Add End Node"
                  Command="{Binding AddNodeCommand}"
                  CommandParameter="{x:Static vm:NodeKind.End}" />

                <Separator />

                <MenuItem Header="Add NPC Dialogue Node"
                  Command="{Binding AddNodeCommand}"
                  CommandParameter="{x:Static vm:NodeKind.NpcDialogue}" />

                <MenuItem Header="Add Answer Node"
                  Command="{Binding AddNodeCommand}"
                  CommandParameter="{x:Static vm:NodeKind.Answer}" />

                <MenuItem Header="Add Player Dialogue Node"
                  Command="{Binding AddNodeCommand}"
                  CommandParameter="{x:Static vm:NodeKind.PlayerDialogue}" />
            </ContextMenu>
        </Canvas.ContextMenu>
        <i:Interaction.Behaviors>
            <behaviors:CanvasInteractionBehavior
        MouseMoveCommand="{Binding MouseMoveOnCanvasCommand}"
        MouseUpCommand="{Binding CanvasMouseUpCommand}"
        RightClickCommand="{Binding CanvasRightClickCommand}" 
        EmptyClickCommand="{Binding ClearSelectionCommand}"
        SelectionBox="{Binding SelectionBox, Mode=TwoWay}"
        IsSelecting="{Binding IsSelecting, Mode=TwoWay}"
                Zoom="{Binding Zoom, Mode=TwoWay}"
                PanX="{Binding PanX, Mode=TwoWay}"
                PanY="{Binding PanY, Mode=TwoWay}" />
        </i:Interaction.Behaviors>
            <Rectangle Width="100000" Height="100000" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile"
          Viewport="0,0,50,50"
          ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#333333" Thickness="1"/>
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="50,0"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,50"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <ItemsControl ItemsSource="{Binding Connections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                        <Path Style="{StaticResource ConnectionPathStyle}"
                            Stroke="{Binding ColourHex}">
                            <Path.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Delete connection"
                  Command="{Binding DeleteCommand}"
                  CommandParameter="{Binding}" />
                                    <Separator/>
                                    <MenuItem Header="Set colour">
                                        <MenuItem.Icon>
                                            <Rectangle Width="12" Height="12" Fill="{Binding ColourHex}"/>
                                        </MenuItem.Icon>
                                        <MenuItem>
                                            <MenuItem.Header>
                                                <UniformGrid Columns="5" Rows="2">
                                                    <Button Width="24" Height="24" Margin="2" Background="#FFFFFF"
                                Command="{Binding SetColorCommand}" CommandParameter="#FFFFFF"/>
                                                    <Button Width="24" Height="24" Margin="2" Background="#E74C3C"
                                Command="{Binding SetColorCommand}" CommandParameter="#E74C3C"/>
                                                    <Button Width="24" Height="24" Margin="2" Background="#E67E22"
                                Command="{Binding SetColorCommand}" CommandParameter="#E67E22"/>
                                                    <Button Width="24" Height="24" Margin="2" Background="#F1C40F"
                                Command="{Binding SetColorCommand}" CommandParameter="#F1C40F"/>
                                                    <Button Width="24" Height="24" Margin="2" Background="#2ECC71"
                                Command="{Binding SetColorCommand}" CommandParameter="#2ECC71"/>
                                                    <Button Width="24" Height="24" Margin="2" Background="#1ABC9C"
                                Command="{Binding SetColorCommand}" CommandParameter="#1ABC9C"/>
                                                    <Button Width="24" Height="24" Margin="2" Background="#3498DB"
                                Command="{Binding SetColorCommand}" CommandParameter="#3498DB"/>
                                                    <Button Width="24" Height="24" Margin="2" Background="#9B59B6"
                                Command="{Binding SetColorCommand}" CommandParameter="#9B59B6"/>
                                                    <Button Width="24" Height="24" Margin="2" Background="#E91E63"
                                Command="{Binding SetColorCommand}" CommandParameter="#E91E63"/>
                                                    <Button Width="24" Height="24" Margin="2" Background="#95A5A6"
                                Command="{Binding SetColorCommand}" CommandParameter="#95A5A6"/>
                                                </UniformGrid>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </MenuItem>
                                </ContextMenu>
                            </Path.ContextMenu>
                            <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="{Binding StartPoint}">
                                    <BezierSegment Point1="{Binding ControlPoint1}"
                               Point2="{Binding ControlPoint2}"
                               Point3="{Binding EndPoint}" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Nodes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                    <local:NodeView/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
            <Rectangle Visibility="{Binding IsSelecting, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Canvas.Left="{Binding SelectionBox.X}"
                   Canvas.Top="{Binding SelectionBox.Y}"
                   Width="{Binding SelectionBox.Width}"
                   Height="{Binding SelectionBox.Height}"
                   Fill="#332B7DE9"
                   Stroke="#2B7DE9"
                   StrokeThickness="1"
                   IsHitTestVisible="False"/>
        </Canvas>
    </Grid>
</UserControl>
