<Window x:Class="NarativeNodeGraph.Views.BlackboardWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:local="clr-namespace:NarativeNodeGraph.Views"
         Title="Blackboard" Width="280" Height="400"
         Background="#252526">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Content="{Binding BlackboardToggleIcon}"
                Command="{Binding CycleBlackboardPanelCommand}"
                HorizontalAlignment="Right"
                Width="24" Height="24"
                FontSize="14"
                Margin="4"/>

        <local:BlackboardView Grid.Row="1" DataContext="{Binding Blackboard}"/>
    </Grid>
</Window>
