<UserControl x:Class="NarativeNodeGraph.Views.BlackboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:converters="clr-namespace:NarativeNodeGraph.Converters"
             xmlns:local="clr-namespace:NarativeNodeGraph.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:behaviors="clr-namespace:NarativeNodeGraph.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="#252526">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Blackboard" Foreground="White"
                   FontWeight="Bold" Margin="8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Variables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="6,6,6,26">
                                <Grid>
                                    <StackPanel>
                                        <TextBox Text="{Binding Name}" AcceptsReturn="False"
                                            behaviors:EnterKeyBehavior.CommitOnEnter="True"/>
                                        <TextBlock Text="{Binding NameError}"
                                           Foreground="#E74C3C"
                                           FontSize="11"
                                           Visibility="{Binding NameError, Converter={StaticResource NullToVisibilityConverter}}"/>

                                        <ComboBox ItemsSource="{Binding AvailableTypes}"
                                          SelectedItem="{Binding Type}"
                                          Margin="0,4,0,0"/>

                                        <CheckBox Content="Value"
                                              IsChecked="{Binding BoolValue}"
                                              Visibility="{Binding IsBoolType, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="0,4,0,0"/>

                                        <TextBox Text="{Binding Value}" AcceptsReturn="False"
                                             behaviors:EnterKeyBehavior.CommitOnEnter="True"
                                             Visibility="{Binding IsIntType, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Margin="0,4,28,0">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasValueError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#E74C3C"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <TextBlock Text="{Binding ValueError}"
                                           Foreground="#E74C3C"
                                           FontSize="11"
                                           Visibility="{Binding ValueError, Converter={StaticResource NullToVisibilityConverter}}"/>    
                                    </StackPanel>

                                    <Button Content="✕"
                                    Command="{Binding ParentBlackboard.DeleteVariableCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Width="20" Height="20"
                                    Padding="0"
                                    FontSize="11"
                                    Foreground="#E74C3C"
                                    Background="Transparent"
                                    BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Add Variable"
                        Command="{Binding AddVariableCommand}"
                        Margin="8"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
